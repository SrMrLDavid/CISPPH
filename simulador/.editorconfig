root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gd,gdshader,cs,cpp,h,hlsl,glsl,vert,frag,tesc,tese,geom,comp}]
indent_style = tab
indent_size = 4

[*.{json,tres,xml,cfg}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
