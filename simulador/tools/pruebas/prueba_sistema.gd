extends SceneTree
# Prueba del nucleo de datos y reglas (sin escena 3D).
var fallos: int = 0
func ok(c: bool, t: String) -> void:
	if c:
		print("  ok: ", t)
	else:
		fallos += 1
		print("  FALLA: ", t)
func _initialize() -> void:
	call_deferred("correr")
func correr() -> void:
	var s: Node = root.get_node("/root/Sistema")
	s.persistir = false
	s.reiniciar_datos()
	ok(s.usuarios.size() == 13, "13 usuarios de prueba (8 residentes, 2 trabajadores, 3 visitantes)")
	ok(s.validar_login("admin", "admin123"), "login correcto")
	ok(not s.validar_login("admin", "mala"), "login incorrecto")
	ok(s.hash_clave("admin123") == "240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9", "hash SHA-256 = el del documento tecnico")
	var carlos: Dictionary = s.buscar_por_placa("abc 123")
	ok(not carlos.is_empty() and carlos["nombre"] == "Carlos", "busca placa normalizada")
	ok(s.rostro_coincide(5, 5) and not s.rostro_coincide(5, 6), "rostro igual coincide, distinto no (tolerancia 0.55)")
	var r: Dictionary = s.evaluar_acceso("Entrada", "ABC-123", int(carlos["rostro"]), 10)
	ok(r["resultado"] == "autorizado" and r["puesto"] == "R-01", "residente entra y recibe su puesto R-01")
	s.registrar_movimiento("Entrada", carlos, "ABC-123", "permitido", "", r["puesto"], [], 10)
	ok(s.esta_dentro(int(carlos["id"])) and s.puesto_de(int(carlos["id"])) == "R-01", "queda dentro y ocupa R-01")
	var r2: Dictionary = s.evaluar_acceso("Entrada", "ABC-123", int(carlos["rostro"]), 10)
	ok(r2["resultado"] == "denegado", "doble entrada denegada: " + str(r2["motivo"]))
	var r3: Dictionary = s.evaluar_acceso("Salida", "ABC-123", int(carlos["rostro"]), 10)
	ok(r3["resultado"] == "autorizado", "salida permitida")
	s.registrar_movimiento("Salida", carlos, "ABC-123", "permitido", "", r3["puesto"], [], 10)
	ok(not s.esta_dentro(int(carlos["id"])) and s.puesto_de(int(carlos["id"])) == "", "tras salir queda fuera y libera el puesto")
	var r4: Dictionary = s.evaluar_acceso("Salida", "ABC-123", int(carlos["rostro"]), 10)
	ok(r4["resultado"] == "denegado", "doble salida denegada")
	var r5: Dictionary = s.evaluar_acceso("Entrada", "ZZZ-999", 3, 10)
	ok(r5["resultado"] == "revisar" and r5["clasificacion"] == "otro", "placa desconocida pasa a revision")
	var r6: Dictionary = s.evaluar_acceso("Entrada", "ABC-123", int(carlos["rostro"]) + 1, 10)
	ok(r6["resultado"] == "revisar", "rostro distinto con placa conocida -> revisar: " + str(r6["motivo"]))
	var rob: Dictionary = s.buscar_por_placa("PQR-678")
	ok(s.evaluar_acceso("Entrada", "PQR-678", int(rob["rostro"]), 15)["resultado"] == "revisar", "trabajador turno mañana a las 15 h -> revisar")
	ok(s.evaluar_acceso("Entrada", "PQR-678", int(rob["rostro"]), 9)["resultado"] == "autorizado", "trabajador en turno entra")
	var v: Dictionary = s.buscar_por_placa("JKL-012")
	var rv: Dictionary = s.evaluar_acceso("Entrada", "JKL-012", int(v["rostro"]), 9)
	ok(rv["resultado"] == "autorizado" and str(rv["puesto"]).begins_with("V-"), "visitante autorizado usa puesto V-")
	var nuevo: Dictionary = s.registrar_usuario({"rol": "residente", "nombre": "Test", "apellido": "Uno", "tipo_id": "CC", "cedula": "999", "parqueadero": "R-20", "placa": "QWE-111"})
	ok(bool(nuevo["ok"]), "registra usuario nuevo")
	ok(not bool(s.registrar_usuario({"rol": "residente", "nombre": "Test", "apellido": "Dos", "tipo_id": "CC", "cedula": "999", "parqueadero": "R-21", "placa": "QWE-222"})["ok"]), "cédula repetida rechazada")
	ok(not bool(s.registrar_usuario({"rol": "residente", "nombre": "T", "apellido": "T", "tipo_id": "CC", "cedula": "998", "parqueadero": "R-20", "placa": "QWE-333"})["ok"]), "puesto ya asignado rechazado")
	ok(not bool(s.registrar_usuario({"rol": "residente", "nombre": "", "apellido": "T", "tipo_id": "CC", "cedula": "997", "parqueadero": "R-22", "placa": "QWE-444"})["ok"]), "campos vacíos rechazados")
	s.eliminar_usuario(int(nuevo["usuario"]["id"]))
	ok(s.buscar_por_cedula("999").is_empty(), "elimina usuario")
	ok(s.estadisticas()["parqueaderos_totales"] == 40, "40 puestos")
	var c2: Dictionary = s.buscar_por_placa("car 777")
	ok(not c2.is_empty() and int(c2["id"]) == int(carlos["id"]), "placa de un vehiculo adicional pertenece al mismo residente")
	var rc2: Dictionary = s.evaluar_acceso("Entrada", "CAR-777", int(carlos["rostro"]), 10, {"tipo": "hatchback", "color": "#2980b9"})
	ok(rc2["resultado"] == "autorizado", "segundo vehiculo del residente con su aspecto correcto entra solo")
	var rc3: Dictionary = s.evaluar_acceso("Entrada", "CAR-777", int(carlos["rostro"]), 10, {"tipo": "sedan", "color": "#c0392b"})
	ok(rc3["resultado"] == "revisar", "misma placa en un vehiculo distinto -> revisar: " + str(rc3["motivo"]))
	ok(int(s.identificar_rostro(int(carlos["rostro"]))["id"]) == int(carlos["id"]), "identifica a quien corresponde un rostro")
	ok(s.identificar_rostro(123456789).is_empty(), "rostro desconocido no se identifica")
	ok(not bool(s.agregar_vehiculo(int(carlos["id"]), "ABC-123", "sedan", "#fff")["ok"]), "placa repetida rechazada al agregar vehiculo")
	# --- reportes por fechas
	ok(bool(s.rango_fechas("", "")["ok"]) and bool(s.rango_fechas("2026-11-01", "2026-11-05")["ok"]), "rango de fechas valido y vacio")
	ok(not bool(s.rango_fechas("01/11/2026", "")["ok"]) and not bool(s.rango_fechas("2026-13-40", "")["ok"]) and not bool(s.rango_fechas("2026-11-05", "2026-11-01")["ok"]), "fechas malas rechazadas")
	var antes: int = s.movimientos.size()
	s.movimientos.append({"id": 9001, "id_usuario": 1, "nombre": "Prueba A", "placa": "AAA-111", "estado": "Entrada", "sentido": "Entrada", "fecha": "2026-11-01 08:00:00", "clasificacion": "residente", "categoria": "No VIP", "registrado_por": "Guardia", "puesto": "R-01", "detalle": "uno; con punto y coma", "fotos": [], "hora_sim": 8})
	s.movimientos.append({"id": 9002, "id_usuario": 1, "nombre": "Prueba B", "placa": "BBB-222", "estado": "Denegado", "sentido": "Entrada", "fecha": "2026-11-03 10:00:00", "clasificacion": "visitante", "categoria": "VIS", "registrado_por": "Guardia", "puesto": "", "detalle": "dos", "fotos": [], "hora_sim": 10})
	ok(s.movimientos_en_rango("2026-11-01", "2026-11-01").size() == 1, "filtra un solo dia")
	ok(s.movimientos_en_rango("2026-11-02", "").size() == 1 and s.movimientos_en_rango("", "2026-11-02").size() == 1 + antes, "limites abiertos")
	var tmp: String = OS.get_cache_dir().path_join("cispph_prueba_hist.csv")
	var ex: Dictionary = s.exportar_historial_csv("2026-11-01", "2026-11-03", tmp)
	ok(bool(ex["ok"]) and int(ex["filas"]) == 2, "exporta 2 filas al CSV")
	var bytes: PackedByteArray = FileAccess.get_file_as_bytes(tmp)
	var txt: String = bytes.get_string_from_utf8()
	ok(bytes.size() > 3 and bytes[0] == 0xEF and bytes[1] == 0xBB and bytes[2] == 0xBF and txt.contains("Prueba A") and txt.contains("Fecha y hora"), "CSV con BOM y encabezado")
	ok(not bool(s.exportar_historial_csv("mañana", "", tmp)["ok"]), "exportar con fecha mala falla sin crear nada")
	DirAccess.remove_absolute(tmp)
	s.movimientos.resize(antes)
	print("FALLOS SISTEMA: ", fallos)
	quit(0)
